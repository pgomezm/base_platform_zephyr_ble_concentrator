lue="disable factory mode" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-factorymode" target="p2-init"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p2-uplinkcfg" target="p2-started"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p2-started" target="p2-hiring"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-e12" value="adv report received" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p2-hiring" target="p2-collect"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-e13" value="keep listening" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-collect" target="p2-hiring"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p2-collect" target="p2-dispatch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-e15" value="NO - keep collecting" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-dispatch" target="p2-hiring"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-e16" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p2-dispatch" target="p2-send"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-e17" value="dispatch complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-send" target="p2-hiring"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-legend" value="Legend: rectangle = state/process (maps to an app/state_machine/*.cpp state or an svc/* action). Diamond = decision.
Original 2022 diagram called this state HIRING (likely a transcription of &quot;HEARING&quot; - listening for advertisements); kept as-is here for traceability, rename to LISTENING in code if preferred.
Not shown: soft_error / hard_error transitions (any state can fault into app/state_machine/soft_error or hard_error, same as deepsight-polaris-software)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="1240" height="90" as="geometry"/></mxCell>
