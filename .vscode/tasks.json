{
    // Every task runs the same Python tools a terminal would. Nothing here
    // knows how to build; it all goes through build_flash_tools/.
    //
    // The interpreter is the workspace virtualenv by full path, not plain
    // `python`. A task terminal does not inherit an activation done in some
    // other window, and esptool lives in that virtualenv, so the Wi-Fi build
    // fails without it. run_build_tool.py says so rather than letting CMake
    // fail twenty seconds later, which is how this was found.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build lora (debug)",
            "type": "shell",
            "command": "${config:concentrator.python} build_flash_tools/run_build_tool.py --variant lora --debug",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "build tcp (debug)",
            "type": "shell",
            "command": "${config:concentrator.python} build_flash_tools/run_build_tool.py --variant tcp --debug",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "build wifi (debug)",
            "type": "shell",
            "command": "${config:concentrator.python} build_flash_tools/run_build_tool.py --variant wifi --debug",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "build lora",
            "type": "shell",
            "command": "${config:concentrator.python} build_flash_tools/run_build_tool.py --variant lora",
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": "$gcc"
        },
        {
            "label": "build wifi",
            "type": "shell",
            "command": "${config:concentrator.python} build_flash_tools/run_build_tool.py --variant wifi",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            // cppdbg does not flash, and flashing an ESP32 over JTAG is slower
            // and more fragile than over UART. So build, flash with esptool,
            // and let the debugger only attach.
            "label": "build and flash wifi (debug)",
            "dependsOrder": "sequence",
            "dependsOn": ["build wifi (debug)", "flash wifi (debug)"],
            "problemMatcher": []
        },
        {
            "label": "flash wifi (debug)",
            "type": "shell",
            "command": "${config:concentrator.python} build_flash_tools/run_flash_tool.py --variant wifi --debug",
            "problemMatcher": []
        },
        {
            "label": "flash lora",
            "type": "shell",
            "command": "${config:concentrator.python} build_flash_tools/run_flash_tool.py --variant lora",
            "problemMatcher": []
        },
        {
            "label": "flash wifi",
            "type": "shell",
            "command": "${config:concentrator.python} build_flash_tools/run_flash_tool.py --variant wifi",
            "problemMatcher": []
        },
        {
            "label": "console",
            "type": "shell",
            "command": "${config:concentrator.python} tests/utils/console.py",
            "problemMatcher": []
        },
        {
            "label": "uplink server",
            "type": "shell",
            "command": "${config:concentrator.python} tests/utils/uplink_server.py --format both",
            "problemMatcher": []
        },
        {
            "label": "format --check",
            "type": "shell",
            "command": "${config:concentrator.python} build_flash_tools/run_format_tool.py --check",
            "problemMatcher": []
        },
        {
            "label": "pytest",
            "type": "shell",
            "command": "${config:concentrator.pytest} tests/pytest",
            "group": "test",
            "problemMatcher": []
        }
    ]
}
