# Build output. west build.dir-fmt puts these under the workspace root, but a
# stray in-tree build directory should never be committed either.
build/
twister-out/

# Python virtualenvs, if one is ever created inside the app folder.
.venv/

# Staging area for files that are obsolete but could not be deleted from this
# machine directly. Nothing here is part of the firmware.
_to_delete/

# Coding-agent workspace config, local to one machine.
.claude/

# Per-installation overrides: LoRaWAN credentials, a site's server address.
# Never committed. prj_local.conf.example documents what goes in it.
prj_local.conf

# Python bytecode from the bench scripts under tests/.
__pycache__/
*.py[cod]
.pytest_cache/

# Git lock files parked here rather than deleted. The remote-devices bridge
# cannot unlink .git/*.lock, so they get moved aside to keep git working. None
# of it is part of the firmware and it is safe to delete at any time.
.gitlocks/

# Build artefacts, named by variant, version and commit hash. Kept locally so a
# board can be re-flashed with exactly what was on it; not committed, because a
# repository is not an artefact store.
output/*.hex
output/*.bin
output/*.elf

# OS and editor droppings.
.DS_Store
Thumbs.db
.idea/
*.log
